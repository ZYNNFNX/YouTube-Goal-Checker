    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            pink: '#ff0055',
                            cyan: '#00f0ff',
                            gold: '#ffe600',
                            bg: '#0a0a0c',
                            card: '#121218',
                            border: '#232330',
                            hover: '#1c1c28'
                        }
                    },
                    fontFamily: {
                        orbitron: ['Orbitron', 'sans-serif'],
                        rajdhani: ['Rajdhani', 'sans-serif'],
