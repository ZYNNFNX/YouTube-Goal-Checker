                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0a0a0c;
            color: #f3f4f6;
            font-family: 'Rajdhani', sans-serif;
        }
        .glow-pink {
            box-shadow: 0 0 25px rgba(255, 0, 85, 0.4);
        }
        .glow-cyan {
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.4);
        }
        .glow-gold {
            box-shadow: 0 0 25px rgba(255, 230, 0, 0.4);
        }
        .glow-text-pink {
            text-shadow: 0 0 12px rgba(255, 0, 85, 0.8);
        }
        .glow-text-cyan {
            text-shadow: 0 0 12px rgba(0, 240, 255, 0.8);
        }
        .glow-text-gold {
            text-shadow: 0 0 12px rgba(255, 230, 0, 0.8);
        }
        .bg-grid {
            background-image: linear-gradient(to right, rgba(0, 240, 255, 0.03) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(255, 0, 85, 0.03) 1px, transparent 1px);
            background-size: 32px 32px;
        }
        
        /* Universal Editable Highlight Styling */
        [contenteditable="true"] {
            outline: none;
            transition: all 0.2s ease;
            border-radius: 4px;
        }
        [contenteditable="true"]:hover {
            background-color: rgba(255, 255, 255, 0.07);
            box-shadow: 0 0 0 1px rgba(0, 240, 255, 0.3);
            cursor: pointer;
        }
        [contenteditable="true"]:focus {
            background-color: rgba(0, 240, 255, 0.1);
            box-shadow: 0 0 0 2px #00f0ff;
            color: #ffffff;
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0a0c;
        }
        ::-webkit-scrollbar-thumb {
            background: #232330;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #ff0055;
        }
    </style>
