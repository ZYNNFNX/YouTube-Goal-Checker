                txt_goalsTitle: "CREATOR TARGET GOALS",
                txt_todoTitle: "ACTION TO-DO LIST",
                txt_rulesTitle: "EDITING RULES & DIRECTIVES",
                txt_benchmarksTitle: "BENCHMARKS & MILESTONES"
            },
            targetDate: "2027-11-05",
            metrics: {
                m1_curr: 42,
                m1_targ: 100,
                m2_curr: 12,
                m2_targ: 30,
                m3_curr: 1250,
                m3_targ: 10000
            },
            schedule: [
                {
                    day: "Monday",
                    focus: "Scripting & Audio Sync",
                    tasks: ["Find viral audio clip", "Set up BPM markers", "Cut intro 5 seconds"]
                },
                {
                    day: "Tuesday",
                    focus: "Batch Editing",
                    tasks: ["Edit 3 High-energy shorts", "Export 4K 60FPS vertical", "Draft titles & tags"]
                },
                {
                    day: "Wednesday",
                    focus: "Main Edit Phase 1",
                    tasks: ["Main sequence masking", "Impact sound effects", "Velocity graph tuning"]
                },
                {
                    day: "Thursday",
                    focus: "Main Edit Phase 2",
                    tasks: ["Color grading & Glow FX", "Typography & Overlays", "Render preview export"]
                },
                {
                    day: "Friday",
                    focus: "Uploads & Teasers",
                    tasks: ["Post Short #1", "Schedule Short #2", "Community tab teaser"]
                },
                {
                    day: "Saturday",
                    focus: "Full Release Day",
                    tasks: ["Final audio master Check", "Thumbnail design", "Publish Video"]
                },
                {
                    day: "Sunday",
                    focus: "Review & Analytics",
                    tasks: ["Analyze CTR & retention", "Plan next week clips", "Rest & recharge"]
                }
            ],
            goals: [
                { id: 1, title: "Hit 50k views on single Short", range: "Week 1", status: "Achieved" },
                { id: 2, title: "Master 3D Masking technique", range: "Week 2", status: "In Progress" },
                { id: 3, title: "Publish 10 Shorts & 2 Long Videos", range: "Month 1", status: "Pending" }
            ],
            todos: [
                { id: 1, text: "Export Thumbnail for Toji Edit", completed: true },
                { id: 2, text: "Clean project files and cache", completed: false },
                { id: 3, text: "Keyframe camera zoom on impact shot", completed: false }
            ],
            rules: [
                "Never compromise on frame precision.",
                "First 3 seconds must grab instant attention.",
                "Always check audio levels on mobile speakers before upload."
            ],
            benchmarks: [
                "Shorts Retention Goal: > 85%",
                "Average View Duration: > 2:30 mins",
                "Upload Consistency: Minimum 4 Shorts/Week"
            ]
        };

        // LOAD APP STATE FROM LOCALSTORAGE OR DEFAULT
        let state = JSON.parse(localStorage.getItem('TOJI_CYBER_HUB_STATE')) || JSON.parse(JSON.stringify(defaultState));

        // SAVE STATE
        function saveState() {
            localStorage.setItem('TOJI_CYBER_HUB_STATE', JSON.stringify(state));
            renderMetrics();
        }

        // SAVE TEXT INLINE
        function saveText(id, val) {
            state.texts[id] = val.trim();
            saveState();
        }

        // RESET TO DEFAULTS
        function resetToDefaults() {
            if (confirm("Reset ALL texts, metrics, schedule, rules, and goals to original default state?")) {
                state = JSON.parse(JSON.stringify(defaultState));
                saveState();
                initApp();
            }
        }

        // INITIALIZE APP
        function initApp() {
            // Restore editable texts
            Object.keys(state.texts).forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.innerText = state.texts[id];
                }
            });

            // Target Date
            document.getElementById('targetDatePicker').value = state.targetDate;

            renderMetrics();
            renderSchedule();
            renderGoals();
            renderTodos();
            renderRules();
            renderBenchmarks();
            startCountdown();
        }

        // METRICS FUNCTIONS
        function updateMetric(key, val) {
            state.metrics[key] = Math.max(0, parseInt(val) || 0);
            saveState();
        }

        function changeMetric(key, delta) {
            state.metrics[key] = Math.max(0, (state.metrics[key] || 0) + delta);
            saveState();
        }

        function renderMetrics() {
            // M1
            document.getElementById('m1_curr').value = state.metrics.m1_curr;
            document.getElementById('m1_targ').value = state.metrics.m1_targ;
            const m1_leftVal = Math.max(0, state.metrics.m1_targ - state.metrics.m1_curr);
            document.getElementById('m1_left').innerText = m1_leftVal;
            const m1_pctVal = state.metrics.m1_targ > 0 ? Math.min(100, Math.round((state.metrics.m1_curr / state.metrics.m1_targ) * 100)) : 0;
            document.getElementById('m1_pct').innerText = `${m1_pctVal}%`;
            document.getElementById('m1_bar').style.width = `${m1_pctVal}%`;

            // M2
            document.getElementById('m2_curr').value = state.metrics.m2_curr;
            document.getElementById('m2_targ').value = state.metrics.m2_targ;
            const m2_leftVal = Math.max(0, state.metrics.m2_targ - state.metrics.m2_curr);
            document.getElementById('m2_left').innerText = m2_leftVal;
            const m2_pctVal = state.metrics.m2_targ > 0 ? Math.min(100, Math.round((state.metrics.m2_curr / state.metrics.m2_targ) * 100)) : 0;
            document.getElementById('m2_pct').innerText = `${m2_pctVal}%`;
            document.getElementById('m2_bar').style.width = `${m2_pctVal}%`;

            // M3
            document.getElementById('m3_curr').value = state.metrics.m3_curr;
            document.getElementById('m3_targ').value = state.metrics.m3_targ;
            const m3_leftVal = Math.max(0, state.metrics.m3_targ - state.metrics.m3_curr);
            document.getElementById('m3_left').innerText = m3_leftVal;
            const m3_pctVal = state.metrics.m3_targ > 0 ? Math.min(100, Math.round((state.metrics.m3_curr / state.metrics.m3_targ) * 100)) : 0;
            document.getElementById('m3_pct').innerText = `${m3_pctVal}%`;
            document.getElementById('m3_bar').style.width = `${m3_pctVal}%`;
        }

        // TIMER FUNCTIONS
        function updateTargetDate(val) {
            state.targetDate = val;
            saveState();
        }

        function startCountdown() {
            setInterval(() => {
                const target = new Date(state.targetDate + "T00:00:00").getTime();
                const now = new Date().getTime();
                const diff = target - now;

                if (diff <= 0) {
                    document.getElementById('countdownDisplay').innerText = "GOAL DATE REACHED!";
                    return;
                }

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                document.getElementById('countdownDisplay').innerText = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            }, 1000);
        }

        // RENDER WEEKLY SCHEDULE
        function renderSchedule() {
            const grid = document.getElementById('weeklyCalendarGrid');
            grid.innerHTML = '';

            state.schedule.forEach((dayData, dayIndex) => {
                const dayCard = document.createElement('div');
                dayCard.className = "bg-black border border-cyber-border rounded-xl p-3 flex flex-col justify-between hover:border-cyber-pink/40 transition shadow-md";
                
                let tasksHTML = dayData.tasks.map((task, taskIndex) => `
                    <div class="flex items-center justify-between text-xs text-gray-300 bg-cyber-card/80 p-1.5 rounded border border-cyber-border/40 group/task">
                        <span contenteditable="true" onblur="updateDayTask(${dayIndex}, ${taskIndex}, this.innerText)" class="outline-none flex-1 hover:text-white">${task}</span>
                        <button onclick="removeDayTask(${dayIndex}, ${taskIndex})" class="opacity-0 group-hover/task:opacity-100 text-red-400 hover:text-red-300 ml-1">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                `).join('');

                dayCard.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between border-b border-cyber-border pb-1.5 mb-2">
                            <span contenteditable="true" onblur="updateDayTitle(${dayIndex}, this.innerText)" class="font-orbitron font-bold text-xs text-cyber-pink uppercase outline-none">${dayData.day}</span>
                            <button onclick="addDayTask(${dayIndex})" class="text-[10px] font-orbitron bg-cyber-pink/20 text-cyber-pink hover:bg-cyber-pink/30 px-1.5 py-0.5 rounded border border-cyber-pink/30">
                                + Task
                            </button>
                        </div>
                        <div contenteditable="true" onblur="updateDayFocus(${dayIndex}, this.innerText)" class="text-xs font-semibold text-cyber-cyan mb-2 outline-none hover:bg-white/5 p-1 rounded">
                            ${dayData.focus}
                        </div>
                        <div class="space-y-1.5">
                            ${tasksHTML}
                        </div>
                    </div>
                `;
                grid.appendChild(dayCard);
            });
        }

        function updateDayTitle(dayIndex, val) {
            state.schedule[dayIndex].day = val.trim();
            saveState();
        }

        function updateDayFocus(dayIndex, val) {
            state.schedule[dayIndex].focus = val.trim();
            saveState();
        }

        function updateDayTask(dayIndex, taskIndex, val) {
            state.schedule[dayIndex].tasks[taskIndex] = val.trim();
            saveState();
        }

        function addDayTask(dayIndex) {
            const newTask = prompt("Enter task for " + state.schedule[dayIndex].day + ":");
            if (newTask) {
                state.schedule[dayIndex].tasks.push(newTask.trim());
                saveState();
                renderSchedule();
            }
        }

        function removeDayTask(dayIndex, taskIndex) {
            state.schedule[dayIndex].tasks.splice(taskIndex, 1);
            saveState();
            renderSchedule();
        }

        // GOALS MANAGEMENT
        function renderGoals() {
            const list = document.getElementById('goalList');
            list.innerHTML = '';

            state.goals.forEach(goal => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between gap-2 p-2.5 rounded-xl bg-black border border-cyber-border hover:border-cyber-cyan/40 transition shadow-sm";
                
                let badgeClass = "bg-gray-800 text-gray-300";
                if (goal.status === "Achieved") badgeClass = "bg-green-500/20 text-green-400 border border-green-500/30";
                if (goal.status === "In Progress") badgeClass = "bg-cyber-pink/20 text-cyber-pink border border-cyber-pink/30";

                item.innerHTML = `
                    <div class="flex-1">
                        <span contenteditable="true" onblur="updateGoalTitle(${goal.id}, this.innerText)" class="text-sm text-gray-200 outline-none hover:text-white">${goal.title}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <select onchange="updateGoalRange(${goal.id}, this.value)" class="bg-cyber-card text-[11px] font-orbitron text-cyber-cyan border border-cyber-border rounded px-1.5 py-1 outline-none">
                            <option value="Today" ${goal.range === "Today" ? "selected" : ""}>Today</option>
                            <option value="Week 1" ${goal.range === "Week 1" ? "selected" : ""}>Week 1</option>
                            <option value="Week 2" ${goal.range === "Week 2" ? "selected" : ""}>Week 2</option>
                            <option value="Month 1" ${goal.range === "Month 1" ? "selected" : ""}>Month 1</option>
                            <option value="Long Term" ${goal.range === "Long Term" ? "selected" : ""}>Long Term</option>
                        </select>
                        <select onchange="updateGoalStatus(${goal.id}, this.value)" class="text-[11px] font-orbitron rounded px-1.5 py-1 border outline-none ${badgeClass}">
                            <option value="Pending" ${goal.status === "Pending" ? "selected" : ""}>Pending</option>
                            <option value="In Progress" ${goal.status === "In Progress" ? "selected" : ""}>In Progress</option>
                            <option value="Achieved" ${goal.status === "Achieved" ? "selected" : ""}>Achieved</option>
                        </select>
                        <button onclick="deleteGoal(${goal.id})" class="text-gray-500 hover:text-red-400 p-1">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
                list.appendChild(item);
            });
        }

        function addGoal() {
            const input = document.getElementById('newGoalTitle');
            const rangeSelect = document.getElementById('newGoalRange');
            if (input.value.trim()) {
                state.goals.push({
                    id: Date.now(),
                    title: input.value.trim(),
                    range: rangeSelect.value,
                    status: "Pending"
                });
                input.value = '';
                saveState();
                renderGoals();
            }
        }

        function updateGoalTitle(id, val) {
            const g = state.goals.find(x => x.id === id);
            if (g) g.title = val.trim();
            saveState();
        }

        function updateGoalRange(id, val) {
            const g = state.goals.find(x => x.id === id);
            if (g) g.range = val;
            saveState();
        }

        function updateGoalStatus(id, val) {
            const g = state.goals.find(x => x.id === id);
            if (g) g.status = val;
            saveState();
            renderGoals();
        }

        function deleteGoal(id) {
            state.goals = state.goals.filter(x => x.id !== id);
            saveState();
            renderGoals();
        }

        // TO-DO LIST MANAGEMENT
        function renderTodos() {
            const list = document.getElementById('todoList');
            list.innerHTML = '';

            state.todos.forEach(todo => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between gap-2 p-2.5 rounded-xl bg-black border border-cyber-border hover:border-cyber-pink/40 transition shadow-sm";

                item.innerHTML = `
                    <div class="flex items-center gap-3 flex-1">
                        <input type="checkbox" ${todo.completed ? 'checked' : ''} onchange="toggleTodo(${todo.id})" class="w-4 h-4 accent-cyber-pink rounded cursor-pointer">
                        <span contenteditable="true" onblur="updateTodoText(${todo.id}, this.innerText)" class="text-sm ${todo.completed ? 'line-through text-gray-500' : 'text-gray-200'} outline-none flex-1">${todo.text}</span>
                    </div>
                    <button onclick="deleteTodo(${todo.id})" class="text-gray-500 hover:text-red-400 p-1">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                `;
                list.appendChild(item);
            });
        }

        function addTodo() {
            const input = document.getElementById('newTodoText');
            if (input.value.trim()) {
                state.todos.push({
                    id: Date.now(),
                    text: input.value.trim(),
                    completed: false
                });
                input.value = '';
                saveState();
                renderTodos();
            }
        }

        function toggleTodo(id) {
            const t = state.todos.find(x => x.id === id);
            if (t) t.completed = !t.completed;
            saveState();
            renderTodos();
        }

        function updateTodoText(id, val) {
            const t = state.todos.find(x => x.id === id);
            if (t) t.text = val.trim();
            saveState();
        }

        function deleteTodo(id) {
            state.todos = state.todos.filter(x => x.id !== id);
            saveState();
            renderTodos();
        }

        // RULES MANAGEMENT
        function renderRules() {
            const container = document.getElementById('rulesList');
            container.innerHTML = '';

            state.rules.forEach((rule, idx) => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between gap-2 text-sm text-gray-300 bg-black p-2.5 rounded-xl border border-cyber-border hover:border-cyber-gold/40 transition";
                item.innerHTML = `
                    <div class="flex items-center gap-2 flex-1">
                        <span class="text-cyber-gold font-orbitron font-bold text-xs">${idx + 1}.</span>
                        <span contenteditable="true" onblur="updateRule(${idx}, this.innerText)" class="outline-none flex-1 hover:text-white">${rule}</span>
                    </div>
                    <button onclick="deleteRule(${idx})" class="text-gray-500 hover:text-red-400 p-1">
                        <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                `;
                container.appendChild(item);
            });
        }

        function addRule() {
            const newR = prompt("Enter new master rule:");
            if (newR) {
                state.rules.push(newR.trim());
                saveState();
                renderRules();
            }
        }

        function updateRule(idx, val) {
            state.rules[idx] = val.trim();
            saveState();
        }

        function deleteRule(idx) {
            state.rules.splice(idx, 1);
            saveState();
            renderRules();
        }

        // BENCHMARKS MANAGEMENT
        function renderBenchmarks() {
            const container = document.getElementById('benchmarksList');
            container.innerHTML = '';

            state.benchmarks.forEach((bm, idx) => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between gap-2 text-sm text-gray-300 bg-black p-2.5 rounded-xl border border-cyber-border hover:border-cyber-cyan/40 transition";
                item.innerHTML = `
                    <div class="flex items-center gap-2 flex-1">
                        <i class="fa-solid fa-angle-right text-cyber-cyan text-xs"></i>
                        <span contenteditable="true" onblur="updateBenchmark(${idx}, this.innerText)" class="outline-none flex-1 hover:text-white">${bm}</span>
                    </div>
                    <button onclick="deleteBenchmark(${idx})" class="text-gray-500 hover:text-red-400 p-1">
                        <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                `;
                container.appendChild(item);
            });
        }

        function addBenchmark() {
            const newB = prompt("Enter new milestone/benchmark:");
            if (newB) {
                state.benchmarks.push(newB.trim());
                saveState();
                renderBenchmarks();
            }
        }

        function updateBenchmark(idx, val) {
            state.benchmarks[idx] = val.trim();
            saveState();
        }

        function deleteBenchmark(idx) {
            state.benchmarks.splice(idx, 1);
            saveState();
            renderBenchmarks();
        }

        // IMPORT / EXPORT DATA
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
            const dlAnchorElem = document.createElement('a');
            dlAnchorElem.setAttribute("href", dataStr);
            dlAnchorElem.setAttribute("download", `TOJI_FNX_CyberHub_${new Date().toISOString().slice(0,10)}.json`);
            dlAnchorElem.click();
        }

        function importData(event) {
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedState = JSON.parse(e.target.result);
                    state = importedState;
                    saveState();
                    initApp();
                    alert("Dashboard configuration successfully loaded!");
                } catch(err) {
                    alert("Invalid JSON configuration file.");
                }
            };
            if (event.target.files[0]) {
                reader.readAsText(event.target.files[0]);
            }
        }

        // ON LOAD INITIALIZATION
        window.onload = function() {
            initApp();
        };
    </script>

</body></html>